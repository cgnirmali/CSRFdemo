# ============================================================
#  .env.example  —  copy this file to ".env" and fill in
#  your own values. NEVER commit your real .env to git.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME="CineVault"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/csrfdemo

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinvault
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------
# Session
# ------------------------------------------------------------
SESSION_NAME=cinvault_session
# Set true when serving over HTTPS; local HTTP development can leave this false.
SESSION_SECURE=false

# ------------------------------------------------------------
# Security demo
# ------------------------------------------------------------
CSRF_PROTECTION_ENABLED=true
LMS_ENV_PATH=C:/xampp/htdocs/Csrf demo projets/LMSDemo/.env
LMS_STATUS_URL=http://127.0.0.1:8001/lms/csrf-demo/status
